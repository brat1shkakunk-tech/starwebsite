<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.site_name %> — <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Ремонт техники' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/"><%= settings.site_name %> ⭐</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
          <li class="nav-item"><a class="nav-link" href="/#services">Услуги</a></li>
          <li class="nav-item"><a class="nav-link" href="/#contacts">Контакты</a></li>
        </ul>
        <div class="d-flex gap-2 flex-wrap">
          <% if (user) { %>
            <span class="navbar-text text-light">Привет, <b><%= user.username %></b></span>
            <% if (user.role === 'admin') { %>
              <a href="/admin" class="btn btn-warning btn-sm">⚙️ Админ панель</a>
            <% } %>
            <a href="/logout" class="btn btn-outline-light btn-sm">Выйти</a>
          <% } else { %>
            <a href="/login" class="btn btn-outline-light btn-sm">Войти</a>
            <a href="/register" class="btn btn-primary btn-sm">Регистрация</a>
          <% } %>
          <button class="btn btn-outline-secondary btn-sm" onclick="document.body.classList.toggle('dark')">🌓</button>
        </div>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <%- body %>
  </main>

  <footer class="bg-dark text-light py-4 mt-5">
    <div class="container text-center">
      <p class="mb-1">📞 <%= settings.phone %> | 📍 <%= settings.address %></p>
      <p class="mb-0 text-muted">© <%= new Date().getFullYear() %> <%= settings.site_name %></p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>
</body>
</html>
