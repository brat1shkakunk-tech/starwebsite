<% var pageTitle = 'Админ панель'; var body = `
<h1>⚙️ Админ панель</h1>
<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link active" href="/admin">Настройки и услуги</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/users">Пользователи</a></li>
</ul>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header"><b>📋 Настройки сайта</b></div>
      <div class="card-body">
        <form method="POST" action="/admin/settings">
          <label>Название сайта</label>
          <input type="text" name="site_name" class="form-control mb-2" value="${settings.site_name}">
          <label>Телефон</label>
          <input type="text" name="phone" class="form-control mb-2" value="${settings.phone}">
          <label>Адрес</label>
          <input type="text" name="address" class="form-control mb-2" value="${settings.address}">
          <label>Email</label>
          <input type="text" name="email" class="form-control mb-2" value="${settings.email}">
          <label>Описание</label>
          <textarea name="about" class="form-control mb-2" rows="2">${settings.about}</textarea>
          <label>Выполнено заказов</label>
          <input type="text" name="completed_orders" class="form-control mb-3" value="${settings.completed_orders}">
          <button class="btn btn-primary w-100">💾 Сохранить</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card">
      <div class="card-header"><b>🛠️ Услуги</b></div>
      <div class="card-body">
        <form method="POST" action="/admin/service" class="mb-3 p-3 bg-light rounded">
          <input type="hidden" name="id" value="">
          <div class="row g-2">
            <input type="text" name="slug" class="form-control" placeholder="slug (phone)" required>
            <input type="text" name="title" class="form-control" placeholder="Название" required>
            <input type="number" name="price" class="form-control" placeholder="Цена" required>
            <input type="text" name="icon" class="form-control" placeholder="Иконка (📱)" value="🔧">
            <textarea name="description" class="form-control" placeholder="Описание"></textarea>
            <button class="btn btn-success">➕ Добавить</button>
          </div>
        </form>
        <div class="list-group">
          ${services.map(s => `
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <div>${s.icon} <b>${s.title}</b> — ${s.price} ₽<br><small class="text-muted">/${s.slug}</small></div>
              <form method="POST" action="/admin/service/delete/${s.id}" onsubmit="return confirm('Удалить?')">
                <button class="btn btn-sm btn-outline-danger">🗑️</button>
              </form>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header"><b>📨 Заявки</b></div>
  <div class="card-body">
    ${orders.length === 0 ? '<p class="text-muted">Пока заявок нет</p>' : `
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>#</th><th>Услуга</th><th>Клиент</th><th>Телефон</th><th>Комментарий</th><th>Статус</th></tr></thead>
          <tbody>
            ${orders.map(o => `
              <tr>
                <td>${o.id}</td>
                <td>${o.service}</td>
                <td>${o.name}</td>
                <td>${o.phone}</td>
                <td>${o.comment || '—'}</td>
                <td>
                  <form method="POST" action="/admin/order/status/${o.id}/STATUS" class="status-form">
                    <select class="form-select form-select-sm" onchange="this.form.action='/admin/order/status/${o.id}/'+this.value; this.form.submit()">
                      <option value="new" ${o.status==='new'?'selected':''}>🆕 Новая</option>
                      <option value="progress" ${o.status==='progress'?'selected':''}>🔧 В работе</option>
                      <option value="done" ${o.status==='done'?'selected':''}>✅ Готово</option>
                    </select>
                  </form>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `}
  </div>
</div>
` %>
<%- include('layout', { body }) %>
